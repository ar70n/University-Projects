  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>450</x>
      <y>0</y>
      <w>258</w>
      <h>162</h>
    </coordinates>
    <panel_attributes>public double importe() {
    double importe = 0;
    PlanPrecios pp = this.getLector().getPlanPrecios();
    double d = pp.getDescuento();

    for (Publicacion pub : this.getPublicaciones()) {
        double pr = pub.getPrecio();
        importe += pr - pr * d;
    }

    for (Acto a : this.getActos()) {
        importe += a.getPrecioActo(this.getLector());
    }

    return importe;
}</panel_attributes>
    <additional_attributes/>
  </element>
