    </coordinates>
    <panel_attributes>public double getPrecio() {
    double precio = 0;
    for (Libro l : this.libros) {
        precio += l.getPrecio();
    }
    precio = precio - precio * this.descuento;
    return precio;
}</panel_attributes>
    <additional_attributes/>
