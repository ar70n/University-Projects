      <h>114</h>
    </coordinates>
    <panel_attributes>public double adeudoMensual(Lector l, LocalDateTime d) {
    double adeudo = 0;
    for (Compra c : compras) {
        if (c.getLector() == l &amp;&amp; c.getLocalDateTime().getMonth() == d.getMonth()) {
            adeudo += c.importe();
        }
    }
    PlanPrecio p = l.getPlanPrecios();
    adeudo += p.getTarifaMensual();
    return adeudo;
}</panel_attributes>
    <additional_attributes/>
  </element>
