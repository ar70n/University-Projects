    <id>UMLNote</id>
    <coordinates>
      <x>912</x>
      <y>726</y>
      <w>240</w>
      <h>66</h>
    </coordinates>
    <panel_attributes>public double getPrecioActo(Lector l) {
int puntos = l.getPuntos();
    if (puntos &gt;= this.puntosParaDescuento) {
        puntos = puntos - this.puntosParaDescuento;
        return this.precio - this.precio * this.descuento;
    }
    return this.precio;
}
</panel_attributes>
    <additional_attributes/>
